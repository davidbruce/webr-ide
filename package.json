{
  "name": "webr-ide",
  "version": "1.0.0",
  "description": "RStudio-style IDE for webR, built for iPad Safari",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "tunnel:preview": "cloudflared tunnel --url http://localhost:4173",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:offline": "playwright test --grep-invert @network",
    "test:pwa": "playwright test -c playwright.pwa.config.ts"
  },
